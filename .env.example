# ──────────────────────────────────────────────
# Photo2Model Backend — Environment Variables
# Copy this file to .env and fill in values
# ──────────────────────────────────────────────

# Directory where generated models are stored
OUTPUT_DIR=./outputs

# Set to "true" to force CPU-only mode (slower but no GPU required)
USE_CPU_FALLBACK=false

# TripoSR mesh resolution: 128 (fast), 256 (default), 512 (high quality, slow)
MESH_RESOLUTION=256

# HuggingFace cache directory (optional)
# HF_HOME=/path/to/hf_cache
